def imhist(X,umbral=None):
    (N,M) = X.shape
    h = np.zeros((256,)) #cada tono de gris
    for i in range(N):
        for j in range(M): #recorre cada pixel
            x = X[i,j] #color del pixel
            h[x] = h[x]+1 #suma uno a el contador

    if umbral is not None:
        recorte=0
        for n in range(256):
            if h[n]>umbral:
                recorte+=h[n]-umbral
                h[n]=umbral

        aumento=recorte/256 #para distribuir
        h=h+aumento

    cdf = np.cumsum(h)

    cdf_normalizado = (cdf / cdf.max()) * 255
    cdf_normalizado = np.round(cdf_normalizado).astype(np.uint8) #para obtener valores discretos

    return cdf_normalizado #array

#para ver el tema de los bins:
def analisisbins(imagen,bins):
    multiplo=256//bins
    return(imagen//multiplo)*multiplo

#trabajaré con malla de divisiones cuadradas
def ecual_local(imagen,umbral,dimension_malla,dimension_paso):
    alto=imagen.shape[0]
    ancho=imagen.shape[1]

    lienzo_ecualizado = np.zeros_like(imagen, dtype=np.float32)
    matriz_pesos = np.zeros_like(imagen, dtype=np.float32)

    alto_malla, ancho_malla = dimension_malla
    paso_y, paso_x = dimension_paso

    xs = list(range(0, ancho - ancho_malla + 1, paso_x))
    if xs[-1] != ancho - ancho_malla:
        xs.append(ancho - ancho_malla) # Fuerza el último bloque al borde derecho

    ys = list(range(0, alto - alto_malla + 1, paso_y))
    if ys[-1] != alto - alto_malla:
        ys.append(alto - alto_malla) #

    #recorrer
    for y in ys:
        for x in xs:

            cuadro=imagen[y:y+alto_malla,x:x+ancho_malla]
            mapa_cdf = imhist(cuadro,umbral)
            cuadro_ecualizado=mapa_cdf[cuadro]
            lienzo_ecualizado[y:y+alto_malla,x:x+ancho_malla]+=cuadro_ecualizado
            matriz_pesos[y:y+alto_malla,x:x+ancho_malla]+=1


    resultado = lienzo_ecualizado / np.maximum(matriz_pesos, 1.0)
    
    return np.round(resultado).astype(np.uint8)

