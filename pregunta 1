##Parte del código que use para gráficar m y para hacer las comparaciones pedidas
def graficarm(h_l, m_l, nombre, ax, color='blue'):
    h_grafica = np.linspace(0, 360, 500)
    m_grafica = np.zeros_like(h_grafica)

    h_extendido = [h_l[-1] - 360.0] + h_l + [h_l[0] + 360.0]
    m_extendido = [m_l[-1]]         + m_l + [m_l[0]]

    for j in range(len(h_grafica)):
        hpixel = h_grafica[j]
        mpixel = 1.0
        for i in range(len(h_extendido) - 1):
            h1 = h_extendido[i]
            h2 = h_extendido[i + 1]
            if h1 <= hpixel <= h2:
                m1 = m_extendido[i]
                m2 = m_extendido[i + 1]
                resta = h2 - h1
                if resta != 0:
                    mpixel = m1 + ((m2 - m1) / (h2 - h1)) * (hpixel - h1)
                else:
                    mpixel = m1
                break
        m_grafica[j] = mpixel

    ax.plot(h_grafica, m_grafica, label=nombre, linewidth=2, color=color)
    ax.scatter(h_l, m_l, color='red', zorder=5, s=40)

