def funcionlab(t): #pasa pasar del cie xyz al cielab
    deltam=6/29
    return np.where(t>(deltam)**3,t ** (1 / 3),(t/(3*deltam**2))+4/29)

def invfunclab(t):
    deltam=6/29
    return np.where(t>(deltam)**3,t ** (3),(t-(4/29))*3*(deltam**2))

def gamma_a_linear(c,gamma):
    return c**gamma

#crear funcion
#h_l lista con valores que quiero modificar
#m_l lista con ganancia correspondiente a cada h_l
#ganacia asociada m    
def colorsaturation(imagen, m_l, h_l, modo):
        
    r=imagen[:,:,0]
    g=imagen[:,:,1]
    b=imagen[:,:,2]

    h_extendido = [h_l[-1] - 360.0] + h_l + [h_l[0] + 360.0]
    m_extendido = [m_l[-1]]         + m_l + [m_l[0]]

    if modo=="HSV": #a hsv

        cmax=(np.maximum(np.maximum(r,g),b))
        cmin=(np.minimum(np.minimum(r,g),b))
        delta=cmax-cmin
        V=cmax
    #H
        H=np.zeros_like(delta)

        mask_r=(cmax==r)*(delta>0)
        mask_g=(cmax==g)*(delta>0)
        mask_b=(cmax==b)*(delta>0)

        H[mask_r] = 60.0 * (((g[mask_r] - b[mask_r]) / delta[mask_r]) % 6)
        H[mask_g] = 60.0 * (((b[mask_g] - r[mask_g]) / delta[mask_g]) + 2)
        H[mask_b]= 60.0 * (((r[mask_b] - g[mask_b]) / delta[mask_b]) + 4)
        
        S = np.where(cmax > 0, delta / (V), 0.0)
        
        alto=H.shape[0]
        ancho=H.shape[1]
    
        for fila in range(alto):
            for col in range(ancho):
                hpixel=H[fila,col]
                mpixel=1
    
                for i in range(len(h_extendido)-1):
                #ahora se requiere buscar la lista
                    h1 = h_extendido[i]
                    h2 = h_extendido[i+1]
    
                    if h1<=hpixel<=h2:
                        m1=m_extendido[i]
                        m2=m_extendido[i+1]
    
                        resta=h2-h1
                        if resta!=0:
                            mpixel=m1+((m2-m1)/(h2-h1))*(hpixel-h1)
                        else: 
                            mpixel=m1
    
                        break
    
                S_nueva = S[fila, col] * mpixel
                if S_nueva > 1.0:
                    S_nueva = 1.0
                S[fila, col] = np.clip(S_nueva,0.0,1.0)

        #La saturación esta definida en [0,1]
        #Si m>1, S_nueva puede superar 1 y se recorta
        #Si m<0,  S_nueva sería negativa.
        #np.clip asegura que esté entre 0 y 1


        imgf = np.stack([H, S, V], axis=-1).astype(np.float32)
        imgf = cv2.cvtColor(imgf, cv2.COLOR_HSV2RGB)

    elif modo=="cielch":
        #pasar de gamma a lineal
        
        r=gamma_a_linear(r,2.2)
        g=gamma_a_linear(g,2.2)
        b=gamma_a_linear(b,2.2)
        
        v=np.stack([r, g, b], axis=-1)
        #primero pasar de rgb a cieXYZ
        matriz=np.array([[0.490,0.310,0.200],[0.177,0.813,0.011],[0.000,0.010,0.990]]) #matriz de calibración

        XYZ=v@matriz.T
        X=XYZ[...,0]
        Y=XYZ[...,1]
        Z=XYZ[...,2]
        
        XN=1 
        YN=1
        ZN=1

        xr = X / XN
        yr = Y / YN
        zr = Z / ZN

        fx=funcionlab(xr)
        fy=funcionlab(yr)
        fz=funcionlab(zr)

        L=116*fy-16
        a=500*(fx-fy)
        b2=200*(fy-fz)

        #pasar a cielch
        c=np.sqrt((a**2)+((b2)**2))
        h=np.degrees(np.arctan2(b2,a))
        h = np.where(h < 0, h + 360.0, h)

        h_extendido = [h_l[-1] - 360.0] + h_l + [h_l[0] + 360.0]
        m_extendido = [m_l[-1]]         + m_l + [m_l[0]]
    
        h_i_periodico = np.array(h_extendido)
        m_i_periodico = np.array(m_extendido)
        
        alto=h.shape[0]
        ancho=h.shape[1]
    
        for fila in range(alto):
            for col in range(ancho):
                hpixel=h[fila,col]
                mpixel=1
    
                for i in range(len(h_extendido)-1):
                #ahora se requiere buscar la lista
                    h1 = h_extendido[i]
                    h2 = h_extendido[i+1]
    
                    if h1<=hpixel<=h2:
                        m1=m_extendido[i]
                        m2=m_extendido[i+1]
    
                        resta=h2-h1
                        if resta!=0:
                            mpixel=m1+((m2-m1)/(h2-h1))*(hpixel-h1)
                        else: 
                            mpixel=m1
    
                        break
    
                c_nueva = c[fila, col] * mpixel
                #Cromaticidad máxima=130
                #Si m>1 y el color ya está saturado, se puede caer fuera del rango
                c_nueva = min(c_nueva, 130.0)
                c[fila, col] = c_nueva

        h=np.radians(h)
        #volver a cieLAB
        a=c*np.cos(h)
        b2=c*np.sin(h)
        
        #volver a cieXYZ

        fy=((L+16)/116)
        fx=(fy+(a/500))
        fz=(fy-((b2)/200))

        X = invfunclab(fx) * XN
        Y = invfunclab(fy) * YN
        Z = invfunclab(fz) * ZN

        imgxyz=np.stack([X, Y, Z], axis=-1)
            
        minv=np.linalg.inv(matriz)
        rgb_final=imgxyz@minv.T
        rgb_final=np.clip(rgb_final,0.0,1.0) #porque hay valores que se pueden salir de los rangos al transformar
        #se debe aplicar correción gamma
        imgf=np.clip(rgb_final**(1.0/2.2),0.0,1.0)

    return imgf

